# Exemplo de arquivo .env para o backend
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.

DATABASE_URL=jdbc:postgresql://localhost:5432/canil
DATABASE_USERNAME=canil
DATABASE_PASSWORD=canil

# update | validate | none (use "none" em produção com migrations controladas)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

SERVER_PORT=3000
